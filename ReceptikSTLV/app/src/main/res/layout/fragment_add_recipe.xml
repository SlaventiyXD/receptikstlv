<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_recipe_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FF6B4E"
            android:layout_marginBottom="24dp" />

        <!-- Название рецепта -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipe_name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/recipeTitleEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_text"
            android:padding="12dp"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"
            />

        <!-- Время приготовления -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preparation_time"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/recipeTimeEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_text"
            android:padding="12dp"
            android:textSize="16sp"
            android:hint="00:00"
            android:inputType="number"
            android:layout_marginBottom="16dp" />

        <!-- Сложность -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/complexity"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/complexitySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_text"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Категория -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/category"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/categorySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/rounded_text"
            android:padding="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Фото -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/photo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/selectPhotoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выбрать фото"
            android:backgroundTint="#FF6B4E"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/recipePhoto"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerCrop"
            android:background="#FFE0E0"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Ингредиенты -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ingredients"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF6B4E"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Поля для добавления нового ингредиента -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/ingredientNameEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Название"
                android:background="@drawable/rounded_text"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/ingredientAmountEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Количество"
                android:background="@drawable/rounded_text"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/addIngredientButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:backgroundTint="#FF6B4E"
                android:minWidth="48dp" />

        </LinearLayout>

        <!-- Список ингредиентов -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ingredientsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Шаги приготовления -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preparation"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF6B4E"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Поля для добавления нового шага -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/stepDescriptionEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Описание шага"
                android:background="@drawable/rounded_text"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/addStepButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:backgroundTint="#FF6B4E"
                android:minWidth="48dp" />

        </LinearLayout>

        <!-- Список шагов -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stepsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Кнопка добавления рецепта -->
        <Button
            android:id="@+id/saveRecipeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_recipe_button"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#FF6B4E"
            android:padding="16dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>