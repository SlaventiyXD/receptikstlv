<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Заливка фона внутри поля -->
    <solid android:color="#FFFFFF" /> <!-- Белый фон -->

    <!-- Скругление углов -->
    <corners android:radius="12dp" /> <!-- Радиус скругления 16dp -->

    <!-- Обводка (рамка) -->
    <stroke
        android:width="2dp"
        android:color="#FF6B4E" />

</shape>